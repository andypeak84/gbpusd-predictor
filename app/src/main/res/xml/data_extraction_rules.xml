<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: same exclusion for cloud backup and for phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="price_alert_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="price_alert_secure.xml" />
    </device-transfer>
</data-extraction-rules>
